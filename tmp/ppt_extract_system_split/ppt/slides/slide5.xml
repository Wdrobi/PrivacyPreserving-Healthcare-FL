ts.org/drawingml/2006/main"><a:off x="1143000" y="4714875" /><a:ext cx="9906000" cy="1095375" /></a:xfrm><a:prstGeom prst="roundRect" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:avLst><a:gd name="adj" fmla="val 7619" /></a:avLst></a:prstGeom><a:solidFill xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:srgbClr val="EAF2F8" /></a:solidFill><a:ln w="19050" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:solidFill><a:srgbClr val="00AEEF" /></a:solidFill><a:prstDash val="solid" /></a:ln></p:spPr><p:txBody><a:bodyPr anchor="ctr" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:normAutofit fontScale="100000" /></a:bodyPr><a:lstStyle xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr algn="ctr"><a:buNone /><a:defRPr sz="1725" b="1"><a:solidFill><a:srgbClr val="1E3A5F" /></a:solidFill><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:defRPr></a:pPr><a:r><a:rPr sz="1725" b="1"><a:solidFill><a:srgbClr val="1E3A5F" /></a:solidFill><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>Research question</a:t></a:r></a:p><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr algn="ctr"><a:buNone /><a:defRPr sz="1725" b="1"><a:solidFill><a:srgbClr val="1E3A5F" /></a:solidFill><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:defRPr></a:pPr><a:r><a:rPr sz="1725" b="1"><a:solidFill><a:srgbClr val="1E3A5F" /></a:solidFill><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>How can multiple institutions train a useful shared model while limiting privacy exposure, encrypted communication cost, poisoning damage, and unilateral control?</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="224" name="visible-footer-date-5"><a:extLst xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId id="{AD61C2BA-765E-42A0-B4FD-3AD8841EC027}" xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" /></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /></p:cNvSpPr><p:nvPr /></p:nvSpPr><p:spPr><a:xfrm xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:off x="466725" y="6381750" /><a:ext cx="1809750" cy="209550" /></a:xfrm><a:prstGeom prst="rect" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:avLst /></a:prstGeom><a:noFill xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /><a:ln w="0" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:noFill /></a:ln></p:spPr><p:txBody><a:bodyPr anchor="ctr" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:normAutofit fontScale="93939" /></a:bodyPr><a:lstStyle xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr algn="l"><a:buNone /><a:defRPr sz="825"><a:solidFill><a:srgbClr val="17365D" /></a:solidFill><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:defRPr></a:pPr><a:r><a:rPr sz="825"><a:solidFill><a:srgbClr val="17365D" /></a:solidFill><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>25 September 2026</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="227" name="problem-paragraph"><a:extLst xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId id="{948838D7-D613-4BEB-8C00-F91DA90BFDC9}" xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" /></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /></p:cNvSpPr><p:nvPr /></p:nvSpPr><p:spPr><a:xfrm xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:off x="1000125" y="1476375" /><a:ext cx="10191750" cy="2952750" /></a:xfrm><a:prstGeom prst="rect" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:avLst /></a:prstGeom><a:noFill xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /><a:ln w="0" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:noFill /></a:ln></p:spPr><p:txBody><a:bodyPr anchor="ctr" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:normAutofit fontScale="100000" /></a:bodyPr><a:lstStyle xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr algn="l"><a:buNone /><a:defRPr sz="1800"><a:solidFill><a:srgbClr val="1F2937" /></a:solidFill><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:defRPr></a:pPr><a:r><a:rPr sz="1800"><a:solidFill><a:srgbClr val="1F2937" /></a:solidFill><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>Although federated learning keeps patient records within each institution, the gradients and model updates exchanged during training may still expose sensitive information through membership inference or reconstruction attacks. Applying CKKS encryption protects update values, but it increases the serialized communication payload and prevents many poisoning defenses from examining individual plaintext updates. Existing systems may also depend on centralized decryption, unverifiable aggregation, or limited audit evidence, which concentrates trust and reduces accountability. Current approaches therefore seldom provide record-level privacy, practical encrypted communication, poisoning resilience, and independently verifiable governance within one evaluated multi-institutional healthcare framework.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId val="2803514658" xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" /></p:ext></p:extLst></p:cSld></p:sld>