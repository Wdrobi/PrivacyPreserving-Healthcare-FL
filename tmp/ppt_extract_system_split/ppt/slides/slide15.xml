wingml/2006/main"><a:off x="904875" y="1381125" /><a:ext cx="10382250" cy="3333750" /></a:xfrm><a:prstGeom prst="rect" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:avLst /></a:prstGeom><a:noFill xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /><a:ln w="0" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:noFill /></a:ln></p:spPr><p:txBody><a:bodyPr xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:normAutofit fontScale="100000" /></a:bodyPr><a:lstStyle xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr marL="254000" indent="-127000"><a:spcAft><a:spcPts val="1000" /></a:spcAft><a:buChar char="•" /><a:defRPr sz="1950"><a:solidFill><a:srgbClr val="1F2937" /></a:solidFill><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:defRPr></a:pPr><a:r><a:rPr sz="1950"><a:solidFill><a:srgbClr val="1F2937" /></a:solidFill><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>No reviewed study evaluates patient-level DP, real CKKS serialization, adaptive common-block compression, poisoning-aware release, and external audit evidence under one protocol.</a:t></a:r></a:p><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr marL="254000" indent="-127000"><a:spcAft><a:spcPts val="1000" /></a:spcAft><a:buChar char="•" /><a:defRPr sz="1950"><a:solidFill><a:srgbClr val="1F2937" /></a:solidFill><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:defRPr></a:pPr><a:r><a:rPr sz="1950"><a:solidFill><a:srgbClr val="1F2937" /></a:solidFill><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>Many compressors reduce plaintext coordinates but recover little or no encrypted network bandwidth.</a:t></a:r></a:p><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr marL="254000" indent="-127000"><a:spcAft><a:spcPts val="1000" /></a:spcAft><a:buChar char="•" /><a:defRPr sz="1950"><a:solidFill><a:srgbClr val="1F2937" /></a:solidFill><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:defRPr></a:pPr><a:r><a:rPr sz="1950"><a:solidFill><a:srgbClr val="1F2937" /></a:solidFill><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>Robust plaintext aggregators require individual update distances that a sum-only encrypted path intentionally hides.</a:t></a:r></a:p><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr marL="254000" indent="-127000"><a:spcAft><a:spcPts val="1000" /></a:spcAft><a:buChar char="•" /><a:defRPr sz="1950"><a:solidFill><a:srgbClr val="1F2937" /></a:solidFill><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:defRPr></a:pPr><a:r><a:rPr sz="1950"><a:solidFill><a:srgbClr val="1F2937" /></a:solidFill><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>Prior evaluations seldom combine paired multi-seed utility, membership inference, gradient reconstruction, one-round poisoning, longitudinal poisoning, and service timing.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="221" name="gap-response"><a:extLst xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId id="{66E1C845-31B3-4F02-9C0E-56EF08B8DD0D}" xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" /></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /></p:cNvSpPr><p:nvPr /></p:nvSpPr><p:spPr><a:xfrm xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:off x="1095375" y="4905375" /><a:ext cx="10001250" cy="952500" /></a:xfrm><a:prstGeom prst="roundRect" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main">